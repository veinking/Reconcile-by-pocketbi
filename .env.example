# PocketBI ID
# Point these to the SAME Supabase Auth project already used by PocketBI.
# The public client key is safe for browser configuration; never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-POCKETBI-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_POCKETBI_PUBLIC_ANON_KEY
